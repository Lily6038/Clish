# Integration test script for runtime testing
# Tests string, math, error handling, and concurrency libraries

echo "Starting integration tests..."

# =====================
# Test string library
# =====================

echo "Testing string.length..."
local len = string.length("hello")
if (len == 5) {
    echo "  PASS: string.length('hello') = 5"
} else {
    echo "  FAIL: expected 5, got " + len
}

echo "Testing string.substring..."
local sub = string.substring("hello", 1, 4)
if (sub == "ell") {
    echo "  PASS: string.substring('hello', 1, 4) = 'ell'"
} else {
    echo "  FAIL: expected 'ell', got " + sub
}

echo "Testing string.replace..."
local rep = string.replace("hello world", "world", "there")
if (rep == "hello there") {
    echo "  PASS: string.replace works"
} else {
    echo "  FAIL: expected 'hello there', got " + rep
}

echo "Testing string.toUpperCase..."
local upper = string.toUpperCase("hello")
if (upper == "HELLO") {
    echo "  PASS: string.toUpperCase works"
} else {
    echo "  FAIL: expected 'HELLO', got " + upper
}

echo "Testing string.toLowerCase..."
local lower = string.toLowerCase("HELLO")
if (lower == "hello") {
    echo "  PASS: string.toLowerCase works"
} else {
    echo "  FAIL: expected 'hello', got " + lower
}

# =====================
# Test math library
# =====================

echo "Testing math.abs..."
local absVal = math.abs(-5)
if (absVal == 5) {
    echo "  PASS: math.abs(-5) = 5"
} else {
    echo "  FAIL: expected 5, got " + absVal
}

echo "Testing math.sqrt..."
local sq = math.sqrt(16)
if (sq == 4) {
    echo "  PASS: math.sqrt(16) = 4"
} else {
    echo "  FAIL: expected 4, got " + sq
}

echo "Testing math.max..."
local mx = math.max(3, 7)
if (mx == 7) {
    echo "  PASS: math.max(3, 7) = 7"
} else {
    echo "  FAIL: expected 7, got " + mx
}

# =====================
# Test Result type (Error Handling)
# =====================

echo "Testing Result type..."

# Test ok/err creation
local okResult = ok(42)
local errResult = err("test error", 5)

if (isOk(okResult)) {
    echo "  PASS: ok() creates ok result"
} else {
    echo "  FAIL: ok() should create ok result"
}

if (isError(errResult)) {
    echo "  PASS: err() creates error result"
} else {
    echo "  FAIL: err() should create error result"
}

# Test unwrap
local val = unwrap(ok(100))
if (val == 100) {
    echo "  PASS: unwrap(ok(100)) = 100"
} else {
    echo "  FAIL: expected 100, got " + val
}

# Test unwrapOr
local defaultVal = unwrapOr(err("fail"), 0)
if (defaultVal == 0) {
    echo "  PASS: unwrapOr(err, 0) = 0"
} else {
    echo "  FAIL: expected 0, got " + defaultVal
}

# Test unwrapOr with ok
local okDefaultVal = unwrapOr(ok(50), 0)
if (okDefaultVal == 50) {
    echo "  PASS: unwrapOr(ok(50), 0) = 50"
} else {
    echo "  FAIL: expected 50, got " + okDefaultVal
}

# =====================
# Test Channels (Concurrency)
# =====================

echo "Testing channels..."

# Create a channel
local ch = channel()

if (ch != nil) {
    echo "  PASS: channel() creates channel"
} else {
    echo "  FAIL: channel() should create channel"
}

# Note: Full channel testing requires spawn/receive which
# may behave differently in test environment

# =====================
# Test Spawn/Wait
# =====================

echo "Testing spawn and wait..."

# Spawn a simple background task
spawn {
    # Background task
}

echo "  PASS: spawn executed without error"

# Wait for background tasks
wait

echo "  PASS: wait completed"

echo "Integration tests complete!"
